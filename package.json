{
  "name": "@zhangsubo/antigravity-zh-cn",
  "version": "2.32.1.3",
  "private": true,
  "description": "Scoped Simplified Chinese UI localization for Antigravity Desktop",
  "license": "MIT",
  "scripts": {
    "build": "node -e \"const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.platform==='win32'?'python':'python3',['tools/patcher.py','build'],{stdio:'inherit'}).status??1)\"",
    "test": "node --test tests/runtime.test.cjs && node -e \"const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.platform==='win32'?'python':'python3',['-m','unittest','discover','-s','tests','-p','test_*.py'],{stdio:'inherit'}).status??1)\"",
    "doctor": "node -e \"const{spawnSync}=require('node:child_process');process.exit(spawnSync(process.platform==='win32'?'python':'python3',['tools/patcher.py','doctor'],{stdio:'inherit'}).status??1)\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
